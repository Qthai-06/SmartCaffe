SMARTCAFE_ADMIN_EMAIL=admin@smartcafe.local
SMARTCAFE_ADMIN_PASSWORD=change-this-password
SMARTCAFE_ADMIN_NAME=Quản trị viên
SMARTCAFE_ADMIN_ROLE=admin

# Optional: JSON list users, will override admin email/password above.
# SMARTCAFE_AUTH_USERS_JSON=[{"email":"admin@smartcafe.local","password":"change-this-password","name":"Admin","role":"admin"}]

# Optional: explicit model path.
# SMARTCAFE_MODEL_PATH=/app/smartcafe_ai/data/models/best.pt

# Optional: expected class names.
# SMARTCAFE_CLASSES=cafe_hat,cafe_xay,ly_giay,ly_nhua,sua_dac

# Optional: database path.
# SMARTCAFE_DB_PATH=/app/smartcafe_ai/data/db/smartcafe.db
